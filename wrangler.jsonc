  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "game-progress", "database_id": "a98fc1d1-12af-4b1f-913c-506995391d8c", "migrations_dir": "migrations" }]
}
